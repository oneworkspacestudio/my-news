Page App
  Row variant=topbar
    Link href="#briefing" variant=brand
      Image src="./news.svg" alt=""
      Text "My News"
    Row variant=search
      Icon name=Search
      Input name=query placeholder="Search stories, topics and publishers" label="Search news"
    Spacer
    Button action=theme variant=icon label="Switch light or dark theme"
      Icon name=SunMoon
    Link href=$workspace variant=apps label="Workspace apps"
      Icon name=Grid2X2
    If condition=$loggedIn
      Button action=logout variant=avatar label="Sign out and remove offline data" $initials
  If condition=$message
    Alert variant=$messageKind $message
  If condition=$loggedIn
    Grid variant=layout
      Stack variant=sidebar
        Text variant=nav-label "YOUR NEWSROOM"
        For each=$navigation
          Button action=navigate item=$item.id variant=$item.variant pressed=$item.active
            Icon name=$item.icon
            Text $item.label
        Divider
        Text variant=nav-label "EXPLORE TOPICS"
        For each=$topics
          Button action=topic item=$item.id variant=$item.variant pressed=$item.active
            Icon name=$item.icon
            Text $item.id
        Spacer
        Stack variant=sidebar-note
          Icon name=Globe2 size=28
          Text "A world of perspectives."
          Text variant=muted "Independent sources. Your own reading list."
      Stack variant=main
        If condition=$offline
          Alert variant=offline "You’re offline. Your saved reading copies are ready to read."
        If condition=$reader
          Stack variant=reader
            Row variant=reader-actions
              Button action=closeReader variant=secondary
                Icon name=ArrowLeft
                Text "Back to stories"
              Spacer
              Button action=fontSmaller variant=icon label="Smaller reading text"
                Icon name=Minus
              Button action=fontLarger variant=icon label="Larger reading text"
                Icon name=Plus
            Row variant=story-meta
              Badge $reader.category
              Text $reader.region
              Text $reader.dateLabel
            Heading level=1 $reader.title
            Row variant=byline
              Icon name=Newspaper
              Text $reader.source
              Spacer
              Button action=saveReader variant=primary disabled=$busy
                Icon name=Download
                Text $reader.saveLabel
            Alert variant=reading-note $reader.readingNote
            Section variant=article-body
              For each=$reader.paragraphs
                Text variant=body $item
            Link href=$reader.url external=true variant=publisher
              Text "Read original at publisher"
              Icon name=ArrowUpRight
        Else
          Row variant=page-heading
            Stack
              Text variant=eyebrow $date
              Heading level=1 $title
              Text variant=subtitle $subtitle
            Spacer
            Button action=refresh variant=secondary disabled=$refreshDisabled label="Refresh news"
              Icon name=RefreshCw
              Text $refreshLabel
          If condition=$showSources
            Card variant=source-form
              Heading level=2 "Bring your own perspective"
              Text variant=muted "Add a publisher’s RSS or Atom feed. Local, international, or something wonderfully specific."
              Grid variant=form
                Input name=sourceName placeholder="Publisher name" label="Publisher name"
                Input name=sourceURL placeholder="https://example.com/feed.xml" label="RSS or Atom feed URL"
                Input name=sourceRegion placeholder="City, country or region" label="Source location"
                Select name=sourceCategory options=$categoryOptions label="Source category"
              Button action=addSource variant=primary disabled=$busy
                Icon name=Plus
                Text "Add source"
            Stack variant=sources
              For each=$sources
                Card variant=source
                  Row
                    Icon name=Rss
                    Stack
                      Heading level=3 $item.name
                      Text variant=muted $item.description
                    Spacer
                    Button action=removeSource item=$item.id variant=icon label="Remove source" disabled=$offline
                      Icon name=Trash2
                  If condition=$item.error
                    Text variant=error $item.error
                  Else
                    Text variant=caption $item.status
          Else
            If condition=$showBriefing
              Card variant=welcome
                Stack
                  Badge variant=welcome "THE BIGGER PICTURE"
                  Heading level=2 "Your world, in perspective."
                  Text "Explore the stories shaping our world. Make room for a different point of view."
                  Row variant=welcome-stats
                    Text $sourceCount
                    Text "•"
                    Text $regionCount
                Section variant=globe
                  Icon name=Globe2 size=150
            Row variant=filters
              Row variant=location
                Icon name=MapPin
                Select name=region options=$regionOptions label="News location"
              Select name=sort options=$sortOptions label="Sort stories"
              Spacer
              If condition=$showSaved
                Button action=downloadSaved variant=secondary disabled=$refreshDisabled
                  Icon name=Download
                  Text "Download library to this device"
              Else
                Button action=followTopic variant=secondary
                  Icon name=Star
                  Text $followLabel
            Row variant=section-heading
              Heading level=2 $sectionTitle
              Text variant=muted $resultLabel
            If condition=$empty
              Card variant=empty
                Icon name=$emptyIcon size=42
                Heading level=2 $emptyTitle
                Text $emptyText
                If condition=$canRefresh
                  Button action=refresh variant=primary disabled=$busy "Refresh news"
            Else
              Grid variant=stories
                For each=$stories
                  Card variant=$item.cardVariant
                    Button action=read item=$item.id variant=story-open label=$item.readLabel
                      Row variant=story-meta
                        Text variant=source $item.source
                        Spacer
                        Icon name=$item.icon
                      Badge variant=category $item.category
                      Heading level=2 $item.title
                      Text variant=summary $item.summary
                    Row variant=story-footer
                      Text variant=caption $item.region
                      Text variant=caption $item.dateLabel
                      Spacer
                      Button action=save item=$item.id variant=$item.saveVariant label=$item.saveLabel disabled=$busy
                        Icon name=$item.saveIcon
                    If condition=$item.offlineLabel
                      Text variant=offline-label $item.offlineLabel
              If condition=$hasMore
                Button action=more variant=secondary "Show more stories"
          Row variant=footer
            Text "MY NEWS"
            Text $footer
            Spacer
            Text "A little more informed. A little more connected."
  Else
    Stack variant=login
      Image src="./news.svg" alt="My News"
      Text variant=eyebrow "YOUR WORLD, IN PERSPECTIVE"
      Heading level=1 $loginTitle
      Text "A personal newsroom. Stories from around the world, ready whenever you are."
      If condition=$oidc
        Link href="./auth/login" variant=primary "Continue with MyAccounts"
      Else
        Input name=email type=email placeholder="Email address" label="Email address"
        Input name=password type=password placeholder="Password" label="Password" action=login
        Button action=login variant=primary disabled=$busy $loginLabel
      Text variant=muted "Saved reading copies stay on this device until you sign out or clear them."
